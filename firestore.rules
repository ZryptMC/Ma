rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'timeSeconds', 'keysCollected', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 16 &&
        request.resource.data.timeSeconds is number &&
        request.resource.data.timeSeconds > 0 &&
        request.resource.data.timeSeconds < 3600 &&
        request.resource.data.keysCollected is number &&
        request.resource.data.keysCollected >= 0 &&
        request.resource.data.keysCollected <= 3;

      allow update, delete: if false;
    }
  }
}
